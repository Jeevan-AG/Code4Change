# KaushalPass Backend — Person 1 required variables

APP_NAME=KaushalPass API
APP_VERSION=1.0
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# Supabase (Dashboard → Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_JWKS_URL=

# Redis — use Upstash dashboard → Redis → copy "redis://default:TOKEN@....upstash.io:6379"
# (NOT the https:// REST URL)
REDIS_URL=redis://default:YOUR_TOKEN@wise-rhino-136049.upstash.io:6379

# Sarvam AI — https://dashboard.sarvam.ai
SARVAM_API_KEY=your-sarvam-api-key

# NVIDIA NIM — https://build.nvidia.com
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
GLM_MODEL=z-ai/glm-5.1

# Storage buckets (create in Supabase Storage — all private, signed URLs)
TTS_BUCKET=tts-audio
DOCUMENTS_BUCKET=documents
CERTIFICATES_BUCKET=certificates
TTS_SIGNED_URL_EXPIRY_SECONDS=3600
STORAGE_SIGNED_URL_EXPIRY_SECONDS=3600
APP_URL=http://localhost:3000
NEMOTRON_MODEL=nvidia/nemotron-3-nano-omni-30b

VOICE_ASSESS_DAILY_LIMIT=10
